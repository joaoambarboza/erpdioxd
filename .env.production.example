# Copie este arquivo para ".env" na VPS (ao lado do docker-compose.yml) e
# preencha os valores reais. O arquivo ".env" real NUNCA deve ser commitado.

# Senha do usuário do Postgres. Gere uma senha forte, por exemplo:
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# Segredo usado pelo NextAuth para assinar sessões. Gere com:
#   openssl rand -base64 32
AUTH_SECRET=

# Domínio que vai apontar para a VPS (ex: erp.dioxd.com.br) ou, se ainda não
# tiver domínio próprio, use "SEU-IP.nip.io" (ex: 203.0.113.10.nip.io) — o
# Caddy consegue emitir certificado HTTPS automático para esse formato também.
DOMAIN=
